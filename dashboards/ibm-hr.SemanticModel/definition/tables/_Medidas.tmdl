			            TREATAS(
			                EmpContexto,
			                'fact-survey'[EmployeeNumber]
			            )
			        ),
			        "Emp",
			        'fact-survey'[EmployeeNumber]
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			RETURN
			    SUMX(
			        ColaboradoresComuns,
			        VAR Emp = [Emp]
			
			        VAR ScoreInicial =
			            CALCULATE(
			                [Indice Felicidade Inicial],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        VAR ScoreAtual =
			            CALCULATE(
			                [Indice Felicidade Atual],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        RETURN
			            IF(
			                ScoreAtual < ScoreInicial,
			                1,
			                0
			            )
			    )
		formatString: 0
		displayFolder: 5-Comparação
		lineageTag: 816e48e7-38b3-4c15-8d90-a58129c6a1b1

	measure '% Amostra comum Melhorou' =
			
