			VAR MediaFelicidade =
			    CALCULATE(
			        AVERAGE('fact-survey'[IndividualHappinessIndex]),
			        'fact-survey'[SurveyDate] = DataInicialSelecionada
			    )
			
			RETURN
			    DIVIDE(
			        MediaFelicidade - 1,
			        3
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3-Questionário-Inicial
		lineageTag: 87ead019-1f3b-4a7c-95be-6fa2844b738f

