	measure '% Satisfacao Ambiente Inicial' = ```
			
			
			VAR DataInicialSelecionada =
			    [DataInicial]
			
			VAR MediaSatisfacaoAmbiente =
			    CALCULATE(
			        AVERAGE('fact-survey'[EnvironmentSatisfaction]),
			        'fact-survey'[SurveyDate] = DataInicialSelecionada,
			        TREATAS(
			            VALUES('fact-attrition'[EmployeeNumber]),
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			RETURN
			    DIVIDE(
			        MediaSatisfacaoAmbiente - 1,
			        3
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3-Questionário-Inicial
		lineageTag: 1b761946-d1b0-459b-b41f-08608f3217cf

	measure '% Indice Felicidade Inicial' =
			
			VAR DataInicialSelecionada =
