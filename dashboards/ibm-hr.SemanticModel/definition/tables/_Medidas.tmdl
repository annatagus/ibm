	measure 'Taxa Horas Extra Atual' =
			
			VAR ColaboradoresSurveyAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 7, 1)
			    )
			
			VAR ColaboradoresComHorasExtra =
			    CALCULATETABLE(
			        VALUES('dim-employee'[EmployeeNumber]),
			        'dim-employee'[OverTime] = "Yes",
			        TREATAS(
			            ColaboradoresSurveyAtual,
			            'dim-employee'[EmployeeNumber]
			        )
			    )
			
			RETURN
			    DIVIDE(
			        COUNTROWS(ColaboradoresComHorasExtra),
			        COUNTROWS(ColaboradoresSurveyAtual),
			        0
			    )
		formatString: 0.0%;-0.0%;0.0%
