table _Medidas
	lineageTag: 3e53132e-386d-44e4-b568-b5a781404dcd

	measure 'Colaboradores Ativos' =
			
			
			CALCULATE(
			    [Total Colaboradores DB],
			    FILTER('fact-attrition', 'fact-attrition'[Attrition] = "No")
			)
		formatString: 0
		displayFolder: 1-População
		lineageTag: 9583f2a0-20dd-4a75-9403-fe4eeae072ad

	measure 'Total Colaboradores Sairam' =
			
			
			CALCULATE(
			    [Total Colaboradores DB],
			    'fact-attrition'[Attrition] = "Yes"
			)
		formatString: 0
		displayFolder: 1-População
		lineageTag: 0ab4bc98-1d34-42f0-b490-794c53f83fcd

	measure 'Racio Masculino' =
			
			
			DIVIDE(
