	measure 'Taxa Viagens Frequentes Atual' =
			
			VAR ColaboradoresSurveyAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 7, 1)
			    )
			
			VAR ColaboradoresComViagensFrequentes =
			    CALCULATETABLE(
			        VALUES('dim-employee'[EmployeeNumber]),
			        'dim-employee'[BusinessTravel] = "Travel_Frequently",
			        TREATAS(
			            ColaboradoresSurveyAtual,
			            'dim-employee'[EmployeeNumber]
			        )
			    )
			
			RETURN
