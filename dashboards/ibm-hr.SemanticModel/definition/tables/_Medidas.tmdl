	measure 'Nr Colaboradores Felicidade Boa ou melhor Inicial' =
			
			VAR DataInicialSelecionada =
			    [DataInicial]
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DataInicialSelecionada,
			        'fact-survey'[IndividualHappinessIndex] >= 3,
			        TREATAS(
			            VALUES('fact-attrition'[EmployeeNumber]),
			            'fact-survey'[EmployeeNumber]
			        )
			    )
		formatString: 0
		displayFolder: 3-Questionário-Inicial
		lineageTag: daf91168-7010-4f27-8ea7-3b570d6c4d8d

	measure 'Taxa Felicidade Atual_v2' =
			
			
			DIVIDE(
			    // total de colaboradores cujas média respostas de satisfaçao foi superior 2,5 (3?) - survey pingpong
			    CALCULATE(
			        DISTINCTCOUNT('fact-survey'[EmployeeNumber]),
			        FILTER('fact-survey', 'fact-survey'[SurveyDate] = [DataAtual]),
			        'fact-survey'[IndividualHappinessIndex] >= 2.5
			    ),
			    // total de colaboradores responderam survey pingpong
			    CALCULATE(
			        DISTINCTCOUNT('fact-survey'[EmployeeNumber]),
			        FILTER('fact-survey', 'fact-survey'[SurveyDate] = [DataAtual])
			    ),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4-Questionário-Atual
		lineageTag: 1957ace7-b69b-4354-a83b-693f7fe2428e

	measure '% Equilibrio Trabalho/Vida Atual_v2' =
			
			VAR DataAtualSelecionada =
			    [DataAtual]
			
			VAR MediaWLB =
			    CALCULATE(
			        AVERAGE('fact-survey'[WorkLifeBalance]),
			        'fact-survey'[SurveyDate] = DataAtualSelecionada,
			        TREATAS(
			            VALUES('fact-attrition'[EmployeeNumber]),
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			RETURN
			    DIVIDE(
			        MediaWLB - 1,
			        3
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4-Questionário-Atual
		lineageTag: edd7ec85-6e59-45e5-8851-cf6ebe59f0bc

