	measure 'Nr Colaboradores Base' =
			
			VAR BaseSelecionada =
			    [Base Remuneração Selecionada]
			
			VAR ColaboradoresBase =
			    CALCULATETABLE(
			        VALUES('Bridge Base Remuneração'[EmployeeNumber]),
			        'Bridge Base Remuneração'[Base] = BaseSelecionada
			    )
			
			VAR ColaboradoresContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR ColaboradoresFinais =
			    INTERSECT(
			        ColaboradoresBase,
			        ColaboradoresContexto
			    )
			
			RETURN
			    COUNTROWS(ColaboradoresFinais)
		formatString: 0
		displayFolder: 6-Remuneração-Carreiras
		lineageTag: 931c623b-11d9-41ed-8f6f-0f9daee16fda

	measure 'Rendimento Médio Base' =
			
			VAR BaseSelecionada =
			    [Base Remuneração Selecionada]
			
			VAR ColaboradoresBase =
			    CALCULATETABLE(
			        VALUES('Bridge Base Remuneração'[EmployeeNumber]),
			        'Bridge Base Remuneração'[Base] = BaseSelecionada
			    )
			
			VAR ColaboradoresContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR ColaboradoresFinais =
			    INTERSECT(
			        ColaboradoresBase,
			        ColaboradoresContexto
			    )
			
			RETURN
			    CALCULATE(
			        AVERAGE('dim-employee'[MonthlyIncome]),
			        TREATAS(
			            ColaboradoresFinais,
			            'dim-employee'[EmployeeNumber]
			        )
			    )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: 6-Remuneração-Carreiras
		lineageTag: 98c73904-036e-474c-84db-ca7cea7e2b98

	measure 'Rendimento Mediano Base' =
			
			VAR BaseSelecionada =
			    [Base Remuneração Selecionada]
			
			VAR ColaboradoresBase =
			    CALCULATETABLE(
			        VALUES('Bridge Base Remuneração'[EmployeeNumber]),
			        'Bridge Base Remuneração'[Base] = BaseSelecionada
			    )
			
			VAR ColaboradoresContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR ColaboradoresFinais =
			    INTERSECT(
			        ColaboradoresBase,
			        ColaboradoresContexto
			    )
			
			RETURN
			    CALCULATE(
			        MEDIAN('dim-employee'[MonthlyIncome]),
			        TREATAS(
			            ColaboradoresFinais,
			            'dim-employee'[EmployeeNumber]
			        )
			    )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: 6-Remuneração-Carreiras
		lineageTag: ca6efc2f-d094-43af-a5a2-5af74f155baa

	measure 'Aumento Salarial Médio Base' =
			
			VAR BaseSelecionada =
			    [Base Remuneração Selecionada]
			
			VAR ColaboradoresBase =
			    CALCULATETABLE(
			        VALUES('Bridge Base Remuneração'[EmployeeNumber]),
			        'Bridge Base Remuneração'[Base] = BaseSelecionada
			    )
			
			VAR ColaboradoresContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR ColaboradoresFinais =
			    INTERSECT(
			        ColaboradoresBase,
			        ColaboradoresContexto
			    )
			
			VAR MediaAumento =
			    CALCULATE(
			        AVERAGE('dim-employee'[PercentSalaryHike]),
			        TREATAS(
			            ColaboradoresFinais,
			            'dim-employee'[EmployeeNumber]
			        )
			    )
			
			RETURN
			    DIVIDE(
			        MediaAumento,
			        100
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 6-Remuneração-Carreiras
		lineageTag: 8d317184-177e-4277-9a87-0f6678cd581d

