	measure 'Felicidade Inicial - Amostra Comum' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 4, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR RespondentesAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			RETURN
			    CALCULATE(
			        [Indice Felicidade Inicial],
			        TREATAS(
			            ColaboradoresComuns,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
		displayFolder: 5-Comparação
		lineageTag: 7247f792-cb2f-4c6e-a282-00373cf6de53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Felicidade Atual - Amostra Comum' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
