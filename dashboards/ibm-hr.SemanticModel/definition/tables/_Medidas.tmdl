table _Medidas
	lineageTag: 3e53132e-386d-44e4-b568-b5a781404dcd

	measure 'Colaboradores Ativos' =
			
			
			CALCULATE(
			    [Total Colaboradores DB],
			    FILTER('fact-attrition', 'fact-attrition'[Attrition] = "No")
