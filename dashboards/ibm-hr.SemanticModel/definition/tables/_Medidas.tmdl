	measure '% Felicidade Inicial - Amostra Comum v2' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 4, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR RespondentesAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			RETURN
			    CALCULATE(
			        [% Indice Felicidade Inicial],
			        TREATAS(
			            ColaboradoresComuns,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5-Comparação
		lineageTag: 7247f792-cb2f-4c6e-a282-00373cf6de53

	measure '% Felicidade Atual - Amostra Comum v2' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 4, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR RespondentesAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			RETURN
			    CALCULATE(
			        [% Indice Felicidade Atual],
			        TREATAS(
			            ColaboradoresComuns,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5-Comparação
		lineageTag: ae073fbf-3f36-450e-91af-e8c57c1875b0

	measure 'Variação Felicidade Amostra comum' =
			
			[% Felicidade Atual - Amostra Comum v2]
			- [% Felicidade Inicial - Amostra Comum v2]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5-Comparação
		lineageTag: 32f413cd-6628-4f68-a1f2-e0d276c45771

	measure '% Variação WLB - Amostra Comum' =
			
			VAR DataInicialSelecionada =
			    [DataInicial]
			
			VAR DataAtualSelecionada =
			    [DataAtual]
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        REMOVEFILTERS('fact-survey'[SurveyDate]),
			        'fact-survey'[SurveyDate] = DataInicialSelecionada,
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR RespondentesAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        REMOVEFILTERS('fact-survey'[SurveyDate]),
			        'fact-survey'[SurveyDate] = DataAtualSelecionada,
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			VAR MediaWLBInicial =
			    CALCULATE(
			        AVERAGE('fact-survey'[WorkLifeBalance]),
			        REMOVEFILTERS('fact-survey'[SurveyDate]),
			        'fact-survey'[SurveyDate] = DataInicialSelecionada,
			        TREATAS(
			            ColaboradoresComuns,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR MediaWLBAtual =
			    CALCULATE(
			        AVERAGE('fact-survey'[WorkLifeBalance]),
			        REMOVEFILTERS('fact-survey'[SurveyDate]),
			        'fact-survey'[SurveyDate] = DataAtualSelecionada,
			        TREATAS(
			            ColaboradoresComuns,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR WLBInicialNormalizado =
			    DIVIDE(
			        MediaWLBInicial - 1,
			        3
			    )
			
			VAR WLBAtualNormalizado =
			    DIVIDE(
			        MediaWLBAtual - 1,
			        3
			    )
			
			RETURN
			    WLBAtualNormalizado - WLBInicialNormalizado
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5-Comparação
		lineageTag: b6c731df-de57-4d5e-916b-135dd76aaf49

	measure 'Nr Colaboradores Melhoraram' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    SELECTCOLUMNS(
			        CALCULATETABLE(
			            VALUES('fact-survey'[EmployeeNumber]),
			            'fact-survey'[SurveyDate] = DATE(2026, 4, 1),
			            TREATAS(
			                EmpContexto,
			                'fact-survey'[EmployeeNumber]
			            )
			        ),
			        "Emp",
			        'fact-survey'[EmployeeNumber]
			    )
			
			VAR RespondentesAtual =
			    SELECTCOLUMNS(
			        CALCULATETABLE(
			            VALUES('fact-survey'[EmployeeNumber]),
			            'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			            TREATAS(
			                EmpContexto,
			                'fact-survey'[EmployeeNumber]
			            )
			        ),
			        "Emp",
			        'fact-survey'[EmployeeNumber]
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			RETURN
			    SUMX(
			        ColaboradoresComuns,
			        VAR Emp = [Emp]
			
			        VAR ScoreInicial =
			            CALCULATE(
			                [% Indice Felicidade Inicial],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        VAR ScoreAtual =
			            CALCULATE(
			                [% Indice Felicidade Atual],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        RETURN
			            IF(
			                ScoreAtual > ScoreInicial,
			                1,
			                0
			            )
			    )
		formatString: 0
		displayFolder: 5-Comparação
		lineageTag: e089dddd-248d-476f-a53a-aff3db88807d

	measure 'Nr Colaboradores Pioraram' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    SELECTCOLUMNS(
			        CALCULATETABLE(
			            VALUES('fact-survey'[EmployeeNumber]),
			            'fact-survey'[SurveyDate] = DATE(2026, 4, 1),
			            TREATAS(
			                EmpContexto,
			                'fact-survey'[EmployeeNumber]
			            )
			        ),
			        "Emp",
			        'fact-survey'[EmployeeNumber]
			    )
			
			VAR RespondentesAtual =
			    SELECTCOLUMNS(
			        CALCULATETABLE(
			            VALUES('fact-survey'[EmployeeNumber]),
			            'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			            TREATAS(
			                EmpContexto,
			                'fact-survey'[EmployeeNumber]
			            )
			        ),
			        "Emp",
			        'fact-survey'[EmployeeNumber]
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			RETURN
			    SUMX(
			        ColaboradoresComuns,
			        VAR Emp = [Emp]
			
			        VAR ScoreInicial =
			            CALCULATE(
			                [% Indice Felicidade Inicial],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        VAR ScoreAtual =
			            CALCULATE(
			                [% Indice Felicidade Atual],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        RETURN
			            IF(
			                ScoreAtual < ScoreInicial,
			                1,
			                0
			            )
			    )
		formatString: 0
		displayFolder: 5-Comparação
		lineageTag: 816e48e7-38b3-4c15-8d90-a58129c6a1b1

	measure '% Amostra comum Melhorou' =
			
			DIVIDE(
			    [Nr Colaboradores Melhoraram],
