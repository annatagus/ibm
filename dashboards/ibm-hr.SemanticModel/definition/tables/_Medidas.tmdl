			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR RespondentesAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			RETURN
			    COUNTROWS(
			        INTERSECT(
			            RespondentesInicial,
			            RespondentesAtual
			        )
			    )
			
			```
		formatString: 0
		displayFolder: 5-Comparação
		lineageTag: 6afbb6b7-7700-49f1-9a18-170760e8490a

