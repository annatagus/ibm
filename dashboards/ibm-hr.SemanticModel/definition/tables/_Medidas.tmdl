		displayFolder: 5-Comparação
		lineageTag: ae073fbf-3f36-450e-91af-e8c57c1875b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variação Felicidade Amostra comum' =
			
			[Felicidade Atual - Amostra Comum]
			- [Felicidade Inicial - Amostra Comum]
		displayFolder: 5-Comparação
		lineageTag: 32f413cd-6628-4f68-a1f2-e0d276c45771

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variação WLB - Amostra Comum' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 4, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR RespondentesAtual =
			    CALCULATETABLE(
			        VALUES('fact-survey'[EmployeeNumber]),
			        'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			        TREATAS(
			            EmpContexto,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			VAR WLBInicial =
			    CALCULATE(
			        [Equilibrio Trabalho/Vida Inicial],
			        TREATAS(
			            ColaboradoresComuns,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			VAR WLBAtual =
			    CALCULATE(
			        [Equilibrio Trabalho/Vida Atual],
			        TREATAS(
			            ColaboradoresComuns,
			            'fact-survey'[EmployeeNumber]
			        )
			    )
			
			RETURN
			    WLBAtual - WLBInicial
		displayFolder: 5-Comparação
		lineageTag: b6c731df-de57-4d5e-916b-135dd76aaf49

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nr Colaboradores Melhoraram' =
			
			VAR EmpContexto =
			    CALCULATETABLE(
			        VALUES('fact-attrition'[EmployeeNumber]),
			        REMOVEFILTERS('fact-attrition'[Attrition])
			    )
			
			VAR RespondentesInicial =
			    SELECTCOLUMNS(
			        CALCULATETABLE(
			            VALUES('fact-survey'[EmployeeNumber]),
			            'fact-survey'[SurveyDate] = DATE(2026, 4, 1),
			            TREATAS(
			                EmpContexto,
			                'fact-survey'[EmployeeNumber]
			            )
			        ),
			        "Emp",
			        'fact-survey'[EmployeeNumber]
			    )
			
			VAR RespondentesAtual =
			    SELECTCOLUMNS(
			        CALCULATETABLE(
			            VALUES('fact-survey'[EmployeeNumber]),
			            'fact-survey'[SurveyDate] = DATE(2026, 7, 1),
			            TREATAS(
			                EmpContexto,
			                'fact-survey'[EmployeeNumber]
			            )
			        ),
			        "Emp",
			        'fact-survey'[EmployeeNumber]
			    )
			
			VAR ColaboradoresComuns =
			    INTERSECT(
			        RespondentesInicial,
			        RespondentesAtual
			    )
			
			RETURN
			    SUMX(
			        ColaboradoresComuns,
			        VAR Emp = [Emp]
			
			        VAR ScoreInicial =
			            CALCULATE(
			                [Indice Felicidade Inicial],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        VAR ScoreAtual =
			            CALCULATE(
			                [Indice Felicidade Atual],
			                TREATAS(
			                    { Emp },
			                    'fact-survey'[EmployeeNumber]
			                )
			            )
			
			        RETURN
			            IF(
			                ScoreAtual > ScoreInicial,
			                1,
			                0
			            )
			    )
		formatString: 0
		displayFolder: 5-Comparação
		lineageTag: e089dddd-248d-476f-a53a-aff3db88807d

	measure 'Nr Colaboradores Pioraram' =
			
